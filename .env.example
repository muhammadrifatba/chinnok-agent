# LLM Provider Key (Anthropic or OpenAI / Azure OpenAI depending on your setup)
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# Database (matches devops/docker-compose.yml default port 5433 and chinook_reader user)
DATABASE_URL=postgresql+psycopg://chinook_reader:mydbpassword@localhost:5433/chinook

# Vector DB (matches devops/docker-compose.yml default port 6334)
QDRANT_URL=http://localhost:6334

# Safety Limits
MAX_RESULT_ROWS=200